# Copy this file to .env and fill in your values
# NEVER commit .env to Git

# App
APP_ENV=development          # development | production
APP_SECRET_KEY=change-this-to-a-long-random-string-in-production
APP_VERSION=1.0.0

# Database
# Development: leave blank to use SQLite
# Production: set to your PostgreSQL URL from Render/Supabase
DATABASE_URL=sqlite:///./adharaai.db
# Document privacy
# How many seconds before uploaded raw text is auto-deleted (default: 300 = 5 min)
DOCUMENT_TTL_SECONDS=300

# Rate limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=10

# File upload limits
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,txt,png,jpg,jpeg,tiff

# CORS — comma-separated list of allowed frontend origins
# Development: http://localhost:3000,http://127.0.0.1:5500
# Production: https://your-frontend-domain.com
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://127.0.0.1:8000
